export function getField(id) {
  return FIELDS.find((f) => f.id === id);
}
export function getInterface(id) {
  return INTERFACES.find((i) => i.id === id);
}
export function getRequirement(id) {
  return REQUIREMENTS.find((r) => r.id === id);
}
