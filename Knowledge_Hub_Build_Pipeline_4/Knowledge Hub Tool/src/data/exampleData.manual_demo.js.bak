  C -->|"IF-033 Dispatch Advice"| D["Carrier Gateway"]
  C -->|"IF-027 Delivery Status"| A
  D -->|"IF-040 POD Confirmation"| A`,
  },
  {
    id: "FLOW-02",
    name: "Transport Plan — Create & Confirm (TMS ⇄ Shippeo)",
    deliverable: "#5",
    description: "The two-leg async exchange used to create a transport plan and receive Shippeo's confirmation of it.",
    interfaces: ["INT-102", "INT-103"],
    diagram: `sequenceDiagram
  participant TMS
  participant Shippeo
  TMS->>Shippeo: INT-102 Create Plan (async)
  Note right of Shippeo: Same business exchange - Leg 2 is Shippeo's async response
  Shippeo-->>TMS: INT-103 Plan Confirmation (async callback)`,
  },
];

