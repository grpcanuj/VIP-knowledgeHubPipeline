{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flow",
  "description": "One end-to-end technical flow, as recorded in the Knowledge Hub. Steps reference Interface IDs already defined in the interface catalogue rather than redefining them.",
  "type": "object",
  "required": ["id", "name", "status", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FLOW-[0-9]{3}$",
      "description": "Unique flow ID, e.g. FLOW-101"
    },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["target", "transitional"],
      "description": "Per Deliverable #5: target and transitional flows are tracked separately"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "description", "technical_owner"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "interface_id": {
            "type": ["string", "null"],
            "pattern": "^IF-[0-9]{3,4}$",
            "description": "Reference to an Interface ID, or null for an internal (non-interface) step"
          },
          "technical_owner": { "type": "string" }
        }
      }
    },
    "monitoring_points": {
      "type": "array",
      "items": { "type": "string" }
    },
    "error_handling": { "type": "string" },
    "recovery": { "type": "string" }
  }
}
